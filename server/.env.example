# FinSight Backend Environment Configuration
PORT=5000
NODE_ENV=production

# MongoDB Connection String (Atlas or local)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/finsight?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=replace_this_with_a_long_random_secret_at_least_32_characters
JWT_EXPIRE=30d
JWT_COOKIE_EXPIRE=30

# Allowed CORS Origins (comma-separated if multiple, e.g. https://your-site.vercel.app,http://localhost:3000)
CORS_ORIGIN=https://your-frontend.vercel.app
CLIENT_URL=https://your-frontend.vercel.app

# Optional ML Microservice URL (leave blank or omit to use built-in resilient inference engine)
ML_SERVICE_URL=
ML_TIMEOUT_MS=4000